nextflow_process {

    name "Test Process FETCHUNZIP"
    script "../main.nf"
    process "FETCHUNZIP"

    tag "modules"
    tag "modules_"
    tag "fetchunzip"

    test("matching checksum unpacks the database") {

        when {
            process {
                """
                input[0] = [
                    ['id': 'phix'],
                    'phix',
                    file("${projectDir}/tests/fixtures/dbs/phix.tar.gz", checkIfExists: true),
                    [],
                    'c8222679734a373fc30f9441ca8251bb',
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out[0].size() == 1
        }
    }

    test("wrong checksum fails") {

        when {
            process {
                """
                input[0] = [
                    ['id': 'phix'],
                    'phix',
                    file("${projectDir}/tests/fixtures/dbs/phix.tar.gz", checkIfExists: true),
                    [],
                    '00000000000000000000000000000000',
                ]
                """
            }
        }

        then {
            assert process.failed
            assert (process.stdout + process.stderr).any { it.contains("md5 checksums don't match") }
        }
    }
}
