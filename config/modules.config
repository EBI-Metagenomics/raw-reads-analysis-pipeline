/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    errorStrategy = { sleep(Math.pow(3, task.attempt) * 45 as long); return 'retry' }
    // errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    // errorStrategy = 'retry'
    maxRetries    = 5
    maxErrors     = '-1'

    withName: SEQKIT_SAMPLE {
        ext.args = '--rand-seed 42'
        ext.prefix = 'subsampled'
    }

    withName: 'PIPELINE:QC:FASTP' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.contains('.json')) {
                    return "${meta.id}_qc.fastp.json"
                }
            },
        ]
    }

    withName: 'PIPELINE:READSMERGE:FASTP_PE' {
        ext.args = '--include_unmerged -A -G -Q -L'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.contains('.json')) {
                    return "${meta.id}_decontamination.fastp.json"
                }
            },
        ]
    }

    withName: 'PIPELINE:READSMERGE:FASTP_SE' {
        ext.args = '-A -G -Q -L'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.contains('.json')) {
                    return "${meta.id}_decontamination.fastp.json"
                }
            },
        ]
    }

    withName: 'PIPELINE:READSMERGE:SEQTK_SEQ' {
        ext.args = '-a'
    }

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: MAPSEQ {
        ext.args = '--outfmt simple'
    }

    withName: 'PIPELINE:ADDHEADER_RRNA' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/taxonomy-summary/${meta.db_label.toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.contains('.txt')) {
                    return "${meta.id}_${meta.db_label.toLowerCase()}.txt"
                }
                if (filename.contains('.txt.gz')) {
                    return "${meta.id}_${meta.db_label.toLowerCase()}.txt.gz"
                }
            },
        ]
    }

    withName: 'PIPELINE:MAPSEQ_OTU_KRONA:KRONA_KTIMPORTTEXT' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/taxonomy-summary/${meta.db_label.toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.contains('.html')) {
                    return "${meta.id}_${meta.db_label.toLowerCase()}.html"
                }
            },
        ]
    }

    withName: 'PIPELINE:MOTUS_KRONA:MOTUS_PROFILE' {
        ext.args = '-c -p -q'
    }

    withName: 'PIPELINE:ADDHEADER_MOTUS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/taxonomy-summary/motus" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.contains('.tsv')) {
                    return "${meta.id}_motus.txt"
                }
                if (filename.contains('.tsv.gz')) {
                    return "${meta.id}_motus.txt.gz"
                }
            },
        ]
    }

    withName: 'PIPELINE:MOTUS_KRONA:KRONA_KTIMPORTTEXT' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/taxonomy-summary/motus" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.contains('.html')) {
                    return "${meta.id}_motus.html"
                }
            },
        ]
    }

    withName: 'PIPELINE:PROFILE_HMMSEARCH_PFAM:HMMER_HMMSEARCH' {
        ext.args = "-Z ${params.databases.pfam.variables.num_models} --cut_ga --noali"
    }

    withName: 'PIPELINE:PROFILE_HMMSEARCH_PFAM:PARSEHMMSEARCHCOVERAGE' {
        ext.args = ""
        publishDir = [
            path: { "${params.outdir}/${meta.id}/function-summary/pfam" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.contains('.json')) {
                    return "${meta.id}_pfam.stats.json"
                }
            },
        ]
    }

    withName: 'PIPELINE:ADDHEADER_PFAM' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/function-summary/pfam" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.contains('.tsv')) {
                    return "${meta.id}_pfam.txt"
                }
                if (filename.contains('.tsv.gz')) {
                    return "${meta.id}_pfam.txt.gz"
                }
            },
        ]
    }

    withName: 'PIPELINE:PROFILE_HMMSEARCH_PFAM:SEQKIT_TRANSLATE' {
        ext.args = "--append-frame --allow-unknown-codon --frame 6 --out-subseqs --min-len 15"
    }

    withName: MULTIQC_STUDY {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        ext.prefix = { "multiqc_report" }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: "*multiqc_report.html",
            saveAs: { filename -> filename.equals('versions.yml') ? null : "study_multiqc_report.html" },
        ]
    }

    withName: MULTIQC_RUN {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        ext.prefix = { "${meta.id}_multiqc_report" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc" },
            mode: params.publish_dir_mode,
            pattern: "*multiqc_report.html",
            saveAs: { filename -> filename.equals('versions.yml') ? null : "${meta.id}_multiqc_report.html" },
        ]
    }
}
