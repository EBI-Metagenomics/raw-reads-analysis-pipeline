docker {
    enabled = true
    autoMounts = true
    fixOwnership = true
}

params {
    decontam_short_chunksize = 160000000
    decontam_long_chunksize = 3200000
    cmsearch_chunksize = 260.MB
    hmmsearch_chunksize = 800.MB
    hmmsearch_subsampling = 2000000
}

process {
    executor = 'local'
    
    resourceLimits  = [ cpus: 1, memory: 1.GB ]

    withName: SEQKIT_SHUFFLE_FASTA {
        resourceLimits  = [ cpus: 1, memory: 16.GB ]
    }

    withName: BBMAP_REFORMAT {
        resourceLimits  = [ cpus: 1, memory: 8.GB ]
    }

    withName: BBMAP_REFORMAT_STANDARDISE {
        resourceLimits  = [ cpus: 1, memory: 8.GB ]
    }

    withName: MOTUS_PROFILE {
        resourceLimits  = [ cpus: 4, memory: 16.GB ]
    }

    withName: INFERNAL_CMSEARCH {
        resourceLimits  = [ cpus: 4, memory: 8.GB ]
    }

    withName: HMMER_HMMSEARCH {
        resourceLimits  = [ cpus: 2, memory: 1.GB ]
    }

    withName: 'PIPELINE:DECONTAM_SHORTREAD:DECONTAM_HOST' {
        resourceLimits  = [ cpus: 4, memory: 16.GB ]
    }

    withName: 'PIPELINE:DECONTAM_LONGREAD:DECONTAM' {
        resourceLimits  = [ cpus: 4, memory: 16.GB ]
    }

    withName: EXTRACTCOORDS {
        resourceLimits  = [ cpus: 1, memory: 4.GB ]
    }

    withName: EASEL_ESLSFETCH {
        resourceLimits  = [ cpus: 1, memory: 4.GB ]
    }

    withName: FASTP {
        resourceLimits  = [ cpus: 4, memory: 4.GB ]
    }

    withName: MAPSEQ {
        resourceLimits  = [ cpus: 4, memory: 8.GB ]
    }

    withName: 'PIPELINE:PROFILE_HMMSEARCH_PFAM:PARSEHMMSEARCHCOVERAGE' {
        resourceLimits  = [ cpus: 1, memory: 16.GB ]
    }
}
