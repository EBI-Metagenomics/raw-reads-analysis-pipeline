manifest {
    mainScript = "main.nf"
}

plugins {
    id 'nf-schema@2.2.0'
}

// Enable modules scripts and strict mode
nextflow {
    enable {
        moduleBinaries = true
        strict = true
    }
}

cleanup = true

params {
    singularity_cachedir = "singularity_cache"

    // --- INPUTS
    samplesheet = ''
    use_fire_download = false

    // --- OUTPUTS
    outdir = "results"
    trace_report_suffix = ""
    publish_dir_mode = 'copy'
    trace_report_suffix = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss' )  // Config options

    // --- RUNNING PARAMETERS
    skip_standardise = false
    skip_qc = false
    skip_decontam = false
    skip_taxonomic = false
    skip_functional = true

    multiqc_config = null
    multiqc_title = ''
    multiqc_logo = null

    save_trimmed_fail = false
    remove_phix = true
    remove_host = true

    decontam_short_chunksize = 1280000000
    decontam_long_chunksize = 12800000
    cmsearch_chunksize = 3.GB
    hmmsearch_chunksize = 1.GB
    pfam_seeded_chunk_reads = 4000000
    hmmsearch_subsampling = 2000000
    pfam_orf_filter = false
    pfam_orf_filter_threshold = -5
    pfam_search_engine = 'hmmsearch'
    // nail and kfpfam: write and publish each domain's alignment, as zstd Parquet
    pfam_alignments = true
    // domains under the gathering thresholds in the alignments too, at this E-value or less; 0 for none
    pfam_weak_evalue = 0
    pfam_nail_seed_pvalue = 0.01

    // pfam_search_engine = 'kfpfam': kfpfam's k-mer prefilter in place of nail's seeding. The prep
    // directory, the tiled index and the image that runs them are built by
    // hpc/pfam-arms/kfpfam_setup.sh from the same Pfam-A.hmm this pipeline searches. Defaults are
    // kfpfam's Mode A (nail's cost, higher recall); Mode B is 20, 16.5, 26.25 with a k4T7.5 index.
    kfpfam_sif = ''
    kfpfam_prep = ''
    kfpfam_index = ''
    kfpfam_bar = 17
    kfpfam_gate = 16.5
    kfpfam_min_gapped = 21.25
    kfpfam_block = 400000
    kfpfam_forward_slack = 8 // HMMER: no domain definition for an ORF this many bits under by Forward; '' for none

    // nail and kfpfam: each sample's Pfam alignments against an index of MGnify's proteins, aligned to the
    // same models, for the closest protein and its labels. The bundle is built by kmer-functional-profiler's
    // workflows/lookup-index, and the image by hpc/pfam-arms/lookup_setup.sh.
    pfam_lookup = false
    pfam_lookup_bundle = ''
    pfam_lookup_sif = ''
    // calls under this share of the read's own score are dropped
    pfam_lookup_floor = 0.4
    // rows the first stage keeps, and how many of those go to the banded score
    pfam_lookup_k = 2000
    pfam_lookup_second = 1000

    force_download_dbs = false

    // --- DBS
    databases {
        cache_path = "download_cache/databases"

        motus {
            remote_path = "ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/tool-dbs/motus/motus_3.0.3.tar.gz"
            remote_checksum_path = "ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/tool-dbs/motus/motus_3.0.3.tar.gz.md5sum"
            local_path = ''
            files {
                base_dir = 'db_mOTU'
            }
        }

        host_genome {
            remote_path = "ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/references/human_GCF_000001405.40/human_GCF_000001405.40_bwamem2.tar.gz"
            remote_checksum_path = "ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/references/human_GCF_000001405.40/human_GCF_000001405.40_bwamem2.tar.gz.md5sum"
            remote_checksum = "6a0d0936105b1878bef58ee3dab9a4a4"
            local_path = ''
            files {
                bwa_index_prefix = 'human_GCF_000001405.40.fna'
            }
        }

        host_genome_minimap2 {
            remote_path = 'ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/references/human_GCF_000001405.40/human_GCF_000001405.40_minimap2.tar.gz'
            remote_checksum_path = 'ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/references/human_GCF_000001405.40/human_GCF_000001405.40_minimap2.tar.gz.md5sum'
            remote_checksum = "7d15464c74ef3ee44081e3cef1bd7648"
            local_path = ''
            files {
                index = 'human_GCF_000001405.40.fna.mmi'
            }
        }

        phix {
            remote_path = 'ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/references/phiX174_GCF_000819615.1/phiX174_GCF_000819615.1_bwamem2.tar.gz'
            remote_checksum_path = 'ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/references/phiX174_GCF_000819615.1/phiX174_GCF_000819615.1_bwamem2.tar.gz.md5sum'
            remote_checksum = "52fda50705858d522e012cfedc7a2299"
            local_path = ''
            files {
                bwa_index_prefix = 'phiX174_GCF_000819615.1.fna'
            }
        }

        rfam {
            remote_path = "ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/tool-dbs/rfam/rfam_15.0_lsu_ssu.tar.gz"
            remote_checksum_path = "ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/tool-dbs/rfam/rfam_15.0_lsu_ssu.tar.gz.md5sum"
            local_path = ''
            files {
                models = 'rfam_15.0_lsu_ssu'
                claninfo = 'rfam_15.0_lsu_ssu/models.claninfo'
            }
        }

        silva_ssu {
            remote_path = "ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/tool-dbs/silva-ssu/silva-ssu_138.1.tar.gz"
            remote_checksum_path = "ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/tool-dbs/silva-ssu/silva-ssu_138.1.tar.gz.md5sum"
            local_path = ''
            files {
                fasta = "SILVA-SSU.fasta"
                tax = "SILVA-SSU-tax.txt"
                otu = "SILVA-SSU.otu"
                mscluster = 'SILVA-SSU.fasta.mscluster'
                version = 'VERSION.txt'
            }
            variables {
                label = 'SSU'
            }
        }

        silva_lsu {
            remote_path = "ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/tool-dbs/silva-lsu/silva-lsu_138.1.tar.gz"
            remote_checksum_path = "ftp://ftp.ebi.ac.uk/pub/databases/metagenomics/pipelines/tool-dbs/silva-lsu/silva-lsu_138.1.tar.gz.md5sum"
            local_path = ''
            files {
                fasta = "SILVA-LSU.fasta"
                tax = "SILVA-LSU-tax.txt"
                otu = "SILVA-LSU.otu"
                mscluster = 'SILVA-LSU.fasta.mscluster'
                version = 'VERSION.txt'
            }
            variables {
                label = 'LSU'
            }
        }

        pfam {
            remote_path = "https://ftp.ebi.ac.uk/pub/databases/Pfam/releases/Pfam39.0/Pfam-A.hmm.gz"
            remote_checksum = "743b20dde4c846dfd67ef30913a4c7b3"
            local_path = ''
            files {
                hmm = "Pfam-A.hmm"
            }
            variables {
                num_models = 53275
            }
        }
    }

    // -- reads qc subwf args
    qc_params {
        filter_amplicon = false
        save_merged = true
    }

    // --- fastp filtering ---
    fastp_params {
        length_filter = 10
        polya_trim = 10
        qualified_quality_phred = 15
        unqualified_percent_limit = 10
    }

    results_file_headers {
        silva_taxonomy = [
            'Count',
            'Superkingdom',
            'Kingdom',
            'Phylum',
            'Class',
            'Order',
            'Family',
            'Genus',
            'Species',
        ]
        motus_taxonomy = [
            'Count',
            'Kingdom',
            'Phylum',
            'Class',
            'Order',
            'Family',
            'Genus',
            'Species',
        ]
    }
}

apptainer.registry = 'quay.io'
docker.registry = 'quay.io'
podman.registry = 'quay.io'
singularity.registry = 'quay.io'
charliecloud.registry = 'quay.io'

// Disable process selector warnings by default.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
    overwrite = true
}

includeConfig 'conf/base.config'

profiles {
    singularity {
        singularity {
            enabled = true
            autoMounts = true
            pullTimeout = "60 min"
            cacheDir = params.singularity_cachedir
        }
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    docker {
        docker {
            enabled             = true
            autoMounts          = true
            fixOwnership        = true
            runOptions          = '-u $(id -u):$(id -g)'
        }
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }

    local {
        includeConfig 'conf/local.config'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

manifest {
    name            = 'ebi-metagenomics/amplicon-analysis-pipeline'
    author          = """Microbiome Informatics Team - EMBL-EBI"""
    contributors    = [
        [
            name: 'Timothy Rozday',
            affiliation: 'EMBL-EBI',
            github: '@timrozday-mgnify',
            contribution: [
                'author',
                'maintainer',
            ],
            orcid: 'https://orcid.org/0000-0001-7016-0665',
        ],
        [
            name: 'Vangelis Karatzas',
            affiliation: 'EMBL-EBI',
            github: '@vagkaratzas',
            contribution: [
                'contributor',
            ],
            orcid: 'https://orcid.org/0000-0001-9132-8981',
        ],
        [
            name: 'Martin Beracochea',
            affiliation: 'EMBL-EBI',
            github: '@mberacochea',
            contribution: [
                'contributor',
                'maintainer',
            ],
            orcid: 'https://orcid.org/0000-0003-3472-3736',
        ],
        [
            name: 'Ekaterina Sakharova',
            affiliation: 'EMBL-EBI',
            github: '@KateSakharova',
            contribution: [
                'contributor',
            ],
            orcid: 'https://orcid.org/0000-0001-6867-2039',
        ],
        [
            name: 'Germana Baldi',
            affiliation: 'EMBL-EBI',
            github: '@Ge94',
            contribution: [
                'contributor',
            ],
            orcid: 'https://orcid.org/0000-0003-1719-5206',
        ],
    ]
    homePage        = 'https://github.com/EBI-Metagenomics/raw-reads-analysis-pipeline'
    description     = """MGnify's raw-reads analysis pipeline generates taxonomic and functional profiles of metagenomes using mOTUs, SILVA, Rfam and Pfam."""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=23.04.0'
    version         = '6.0.0'
}

includeConfig 'conf/modules.config'
