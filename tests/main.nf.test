nextflow_pipeline {

    name "Test Whole Pipeline"
    script "main.nf"

    test("Should run without failures") {

        when {
            params {
	            samplesheet = "${projectDir}/tests/fixtures/rrap/samplesheet_basic.csv"
		        outdir = "$outputDir"
            }
        }

        then {
            def sample_outdir = "${params.outdir}/test_sample"
            def stable_name = getAllFilesFromDir(
                sample_outdir, relative: true, includeDir: true, 
                ignore: ['pipeline_info/*.{html,json,txt}',]
            )
            // stable_path: All files in ${params.outdir}/test_sample/ with stable content
            def stable_path = getAllFilesFromDir(
                sample_outdir,
                ignoreFile: 'tests/.nftignore',
                ignore: ['qc/*.fastp.json']
            )
            def fastp_json_line_counts = getAllFilesFromDir(
                "${sample_outdir}/qc",
                include: ['*.fastp.json']
            )
                .collect { file -> "${file.name} - ${file.readLines().size()} lines" }
                .sort()
            def qc_fastp = new groovy.json.JsonSlurper().parseText(
                path("${sample_outdir}/qc/test_sample_qc.fastp.json").text
            )
            def decontam_fastp = new groovy.json.JsonSlurper().parseText(
                path("${sample_outdir}/qc/test_sample_decontamination.fastp.json").text
            )

            assertAll(
                { assert workflow.success },
                { assert qc_fastp instanceof Map },
                { assert qc_fastp.summary },
                { assert qc_fastp.filtering_result },
                { assert qc_fastp.summary.fastp_version == "0.24.0" },
                { assert qc_fastp.summary.sequencing == "paired end (125 cycles + 125 cycles)" },
                { assert qc_fastp.summary.before_filtering.total_reads == 20000 },
                { assert qc_fastp.summary.after_filtering.total_reads == 19884 },
                { assert qc_fastp.filtering_result.passed_filter_reads == 19884 },
                { assert qc_fastp.filtering_result.too_short_reads == 116 },
                { assert qc_fastp.adapter_cutting },
                { assert qc_fastp.insert_size },
                { assert decontam_fastp instanceof Map },
                { assert decontam_fastp.summary },
                { assert decontam_fastp.filtering_result },
                { assert decontam_fastp.summary.fastp_version == "0.24.0" },
                { assert decontam_fastp.summary.sequencing == "paired end (125 cycles + 125 cycles)" },
                { assert decontam_fastp.summary.before_filtering.total_reads == 19882 },
                { assert decontam_fastp.summary.after_filtering.total_reads == 19626 },
                { assert decontam_fastp.filtering_result.passed_filter_reads == 19882 },
                { assert decontam_fastp.filtering_result.corrected_reads == 3 },
                { assert decontam_fastp.filtering_result.corrected_bases == 4 },
                { assert decontam_fastp.insert_size },
                { assert snapshot(
                    stable_name,
                    stable_path,
                    fastp_json_line_counts,
                ).match() }
            ) 
        }
    }

    test("Skip taxonomic Should run without failures") {

        when {
            params {
	            samplesheet = "${projectDir}/tests/fixtures/rrap/samplesheet_basic.csv"
		        outdir = "$outputDir"
                skip_taxonomic = true
            }
        }

        then {
            def sample_outdir = "${params.outdir}/test_sample"
            def stable_name = getAllFilesFromDir(
                sample_outdir, relative: true, includeDir: true, 
                ignore: ['pipeline_info/*.{html,json,txt}',]
            )
            // stable_path: All files in ${params.outdir}/test_sample/ with stable content
            def stable_path = getAllFilesFromDir(
                sample_outdir,
                ignoreFile: 'tests/.nftignore',
                ignore: ['qc/*.fastp.json']
            )
            def fastp_json_line_counts = getAllFilesFromDir(
                "${sample_outdir}/qc",
                include: ['*.fastp.json']
            )
                .collect { file -> "${file.name} - ${file.readLines().size()} lines" }
                .sort()
            def qc_fastp = new groovy.json.JsonSlurper().parseText(
                path("${sample_outdir}/qc/test_sample_qc.fastp.json").text
            )
            def decontam_fastp = new groovy.json.JsonSlurper().parseText(
                path("${sample_outdir}/qc/test_sample_decontamination.fastp.json").text
            )

            assertAll(
                { assert workflow.success },
                { assert qc_fastp instanceof Map },
                { assert qc_fastp.summary },
                { assert qc_fastp.filtering_result },
                { assert qc_fastp.summary.fastp_version == "0.24.0" },
                { assert qc_fastp.summary.sequencing == "paired end (125 cycles + 125 cycles)" },
                { assert qc_fastp.summary.before_filtering.total_reads == 20000 },
                { assert qc_fastp.summary.after_filtering.total_reads == 19884 },
                { assert qc_fastp.filtering_result.passed_filter_reads == 19884 },
                { assert qc_fastp.filtering_result.too_short_reads == 116 },
                { assert qc_fastp.adapter_cutting },
                { assert qc_fastp.insert_size },
                { assert decontam_fastp instanceof Map },
                { assert decontam_fastp.summary },
                { assert decontam_fastp.filtering_result },
                { assert decontam_fastp.summary.fastp_version == "0.24.0" },
                { assert decontam_fastp.summary.sequencing == "paired end (125 cycles + 125 cycles)" },
                { assert decontam_fastp.summary.before_filtering.total_reads == 19882 },
                { assert decontam_fastp.summary.after_filtering.total_reads == 19626 },
                { assert decontam_fastp.filtering_result.passed_filter_reads == 19882 },
                { assert decontam_fastp.filtering_result.corrected_reads == 3 },
                { assert decontam_fastp.filtering_result.corrected_bases == 4 },
                { assert decontam_fastp.insert_size },
                { assert snapshot(
                    stable_name,
                    stable_path,
                    fastp_json_line_counts,
                ).match() }
            ) 
        }
    }

    test("nail engine gives a Pfam profile and alignments") {

        when {
            params {
                samplesheet = "${projectDir}/tests/fixtures/rrap/samplesheet_basic.csv"
                outdir = "$outputDir"
                pfam_search_engine = 'nail'
            }
        }

        then {
            def pfam = "${params.outdir}/test_sample/function-summary/pfam"
            assert workflow.success
            assert path("${pfam}/test_sample_pfam.txt.gz").linesGzip.size() > 1
            assert file("${pfam}/test_sample_pfam_alignments.parquet").size() > 0
        }
    }

    test("ORF filter gives a Pfam profile and filter stats") {

        when {
            params {
                samplesheet = "${projectDir}/tests/fixtures/rrap/samplesheet_basic.csv"
                outdir = "$outputDir"
                pfam_orf_filter = true
            }
        }

        then {
            def pfam = "${params.outdir}/test_sample/function-summary/pfam"
            assert workflow.success
            assert path("${pfam}/test_sample_pfam.txt.gz").linesGzip.size() > 1
            assert path("${pfam}/test_sample_pfam_orf_filter.stats.json").exists()
        }
    }

    test("ORF filter and nail together") {

        when {
            params {
                samplesheet = "${projectDir}/tests/fixtures/rrap/samplesheet_basic.csv"
                outdir = "$outputDir"
                pfam_orf_filter = true
                pfam_search_engine = 'nail'
            }
        }

        then {
            def pfam = "${params.outdir}/test_sample/function-summary/pfam"
            assert workflow.success
            assert path("${pfam}/test_sample_pfam.txt.gz").linesGzip.size() > 1
            assert path("${pfam}/test_sample_pfam_orf_filter.stats.json").text.contains('"fallback_kept_all_orfs": false')
            assert file("${pfam}/test_sample_pfam_alignments.parquet").size() > 0
        }
    }

    test("nail engine refuses a chunked Pfam database") {

        config "./chunked_pfam.config"

        when {
            params {
                samplesheet = "${projectDir}/tests/fixtures/rrap/samplesheet_basic.csv"
                outdir = "$outputDir"
                pfam_search_engine = 'nail'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("needs an unchunked Pfam database") } ||
                workflow.errorReport.contains("needs an unchunked Pfam database")
        }
    }
}
