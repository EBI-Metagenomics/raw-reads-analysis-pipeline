nextflow_pipeline {

    name "Test Whole Pipeline"
    script "main.nf"

    test("Should run without failures") {

        when {
            params {
	            samplesheet = "${projectDir}/tests/fixtures/rrap/samplesheet_basic.csv"
		        outdir = "$outputDir"
                decontam_short_chunksize = "lots"
            }
        }

        then {
            def sample_outdir = "${params.outdir}/test_sample"
            def stable_name = getAllFilesFromDir(
                sample_outdir, relative: true, includeDir: true, 
                ignore: ['pipeline_info/*.{html,json,txt}',]
            )
            // stable_path: All files in ${params.outdir}/test_sample/ with stable content
            def stable_path = getAllFilesFromDir(sample_outdir, ignoreFile: 'tests/.nftignore')

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    stable_name,
                    stable_path,
                ).match() }
            ) 
        }
    }
}
