/*
    A chunked Pfam database, like the production codon.config's.
    Both chunks point at the same mini fixture, so the hits come twice: the point is that every
    chunk is searched and the pieces are put back together, not what the profile says.
*/
params.databases.pfam = [
    chunked: true,
    pfam_1: [
        remote_path: "${projectDir}/tests/fixtures/dbs/pfam_mini.tar.gz",
        remote_checksum_path: false,
        remote_checksum: false,
        local_path: '',
        files: [hmm: "pfam_mini/Pfam-A.hmm"],
    ],
    pfam_2: [
        remote_path: "${projectDir}/tests/fixtures/dbs/pfam_mini.tar.gz",
        remote_checksum_path: false,
        remote_checksum: false,
        local_path: '',
        files: [hmm: "pfam_mini/Pfam-A.hmm"],
    ],
    variables: [num_models: 21979],
]
