// Slurm and Singularity, from kfp-ablations' site config. Relative paths resolve against this directory.
executor {
    name              = 'slurm'
    queueSize         = 75
    queueGlobalStatus = true
    submitRateLimit   = '10 sec'
    pollInterval      = '10 sec'
}

process.cache = 'lenient'
process.errorStrategy = {
    if (task.attempt == 1) return 'retry'
    if (task.previousException?.toString()?.contains('terminated for an unknown reason')) return 'retry'
    if (task.exitStatus in ((130..145) + 104)) return 'retry'
    return 'finish'
}

trace.fields = 'task_id,hash,native_id,process,tag,status,exit,submit,realtime,cpus,%cpu,peak_rss'

// B11 searched a whole sample's ORFs against one Pfam chunk in a single task: 65 minutes at the
// median and 144 at the worst, with only 2.25 of its 4 cores busy. Smaller read chunks give the
// queue more, shorter tasks, and hmmsearch doesn't scale past about 2 cores here anyway. With
// subsampling off the ORF file is about 20x larger, so this is also what keeps a task finite.
params.hmmsearch_chunksize = 256.MB

process {
    // depot.galaxyproject.org is unreachable from Codon's compute nodes, so pull nail's
    // biocontainer instead: nextflow.config sets singularity.registry = 'quay.io', which makes
    // this quay.io/biocontainers/nail:0.7.1--hab7d0fd_0. Drop this if depot becomes reachable.
    // Resources below are B11's measurements, not guesses; see docs/plans V5 results.
    // conf/modules.config allows it 1 cpu, 1 GB and 1 hour, which was sized for a 2 M subsample.
    // The seeded arms now translate one 4 M-read chunk per task, but the hmmsearch arms still
    // translate a whole library in one, so this has to cover 40 M reads. It streams, so the
    // memory is incidental; the hour is the part that would fail.
    withName: SEQKIT_TRANSLATE {
        cpus = 1
        memory = { 8.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxRetries = 2
    }

    withName: HMMER_HMMSEARCH {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }

    // The seeded arms now chunk their reads (pfam_seeded_chunk_reads, 4 M), so the steps below are
    // one task per 4 M reads rather than one per sample: about ten tasks for each of these
    // libraries. That bounds every request here, and the retry ladder covers the estimate being
    // wrong, so these are sized for the queue rather than for the worst sample.
    //
    // No `disk` request: nail's --tmp-dir is the task's work directory on /hps/nobackup, so asking
    // Slurm for node-local space only blocks submission. Its MMseqs2 temporaries go there and
    // dwarf the seed file, which is what filled a disk in the plan's V4: watch the first sample.
    // B11 measured 1.6 min and 16.6 GB against a twentieth of Pfam and 2 M reads; a chunk here is
    // twice the reads against the whole database, so treat that only as a lower bound.
    withName: NAIL_SEED {
        ext.singularity_pull_docker_container = true
        cpus = 16
        memory = { 64.GB * task.attempt }
        time = { 12.h * task.attempt }
        maxRetries = 2
    }

    // kfpfam's prefilter, one task per read chunk. Its 400,000-ORF blocks should keep memory flat
    // within a chunk where nail's grows with it.
    withName: KFPFAM_FILTER {
        cpus = 16
        memory = { 48.GB * task.attempt }
        time = { 12.h * task.attempt }
        maxRetries = 2
    }

    // Holds every domain it reports in memory before writing the Parquet. Read chunking is what
    // bounds that now; if it is still killed, stream the Parquet rather than raising this again.
    withName: HMMER_PAIRS {
        cpus = 8
        memory = { 64.GB * task.attempt }
        time = { 12.h * task.attempt }
        maxRetries = 2
    }

    // Reads every chunk's Parquet back to sort one per sample, so it is the one step read
    // chunking makes heavier rather than lighter: more inputs, same total rows.
    withName: MERGEPARQUET {
        memory = { 64.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxRetries = 2
    }
}
