// Slurm and Singularity, from kfp-ablations' site config. Relative paths resolve against this directory.
executor {
    name              = 'slurm'
    queueSize         = 75
    queueGlobalStatus = true
    submitRateLimit   = '10 sec'
    pollInterval      = '10 sec'
}

process.cache = 'lenient'
process.errorStrategy = {
    if (task.attempt == 1) return 'retry'
    if (task.previousException?.toString()?.contains('terminated for an unknown reason')) return 'retry'
    if (task.exitStatus in ((130..145) + 104)) return 'retry'
    return 'finish'
}

trace.fields = 'task_id,hash,native_id,process,tag,status,exit,submit,realtime,cpus,%cpu,peak_rss'

// B11 searched a whole sample's ORFs against one Pfam chunk in a single task: 65 minutes at the
// median and 144 at the worst, with only 2.25 of its 4 cores busy. Smaller read chunks give the
// queue more, shorter tasks, and hmmsearch doesn't scale past about 2 cores here anyway. With
// subsampling off the ORF file is about 20x larger, so this is also what keeps a task finite.
params.hmmsearch_chunksize = 256.MB

process {
    // depot.galaxyproject.org is unreachable from Codon's compute nodes, so pull nail's
    // biocontainer instead: nextflow.config sets singularity.registry = 'quay.io', which makes
    // this quay.io/biocontainers/nail:0.7.1--hab7d0fd_0. Drop this if depot becomes reachable.
    // Resources below are B11's measurements, not guesses; see docs/plans V5 results.
    withName: HMMER_HMMSEARCH {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }

    // One task per sample, not one per chunk, and no `disk` request: nail's --tmp-dir is the
    // task's work directory on /hps/nobackup, so asking Slurm for node-local space only blocks
    // submission. Seeding is one task per sample over a whole library's ORFs now that subsampling is off, so
    // B11's figures (1.6 minutes, 16.6 GB, against a twentieth of Pfam and 2 M reads) are a
    // floor. nail's MMseqs2 temporaries go to the task's work directory and dwarf its seed file,
    // which is what filled a disk in the plan's V4: watch the first sample.
    withName: NAIL_SEED {
        ext.singularity_pull_docker_container = true
        cpus = 16
        memory = { 120.GB * task.attempt }
        time = { 48.h * task.attempt }
        maxRetries = 2
    }

    // kfpfam's prefilter, also one task per sample. Its 400,000-ORF blocks should keep memory
    // flat where nail's grows with the sample.
    withName: KFPFAM_FILTER {
        cpus = 16
        memory = { 64.GB * task.attempt }
        time = { 48.h * task.attempt }
        maxRetries = 2
    }

    // Holds every reported domain in memory before writing the Parquet, and MERGEPARQUET reads
    // them back to sort. If either is killed, stream the Parquet rather than raising these again.
    withName: HMMER_PAIRS {
        cpus = 8
        memory = { 120.GB * task.attempt }
        time = { 24.h * task.attempt }
        maxRetries = 2
    }

    withName: MERGEPARQUET {
        memory = { 64.GB * task.attempt }
        time = { 4.h * task.attempt }
        maxRetries = 2
    }
}
