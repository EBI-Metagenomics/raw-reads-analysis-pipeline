// Slurm and Singularity, from kfp-ablations' site config. Relative paths resolve against this directory.
executor {
    name              = 'slurm'
    queueSize         = 75
    queueGlobalStatus = true
    submitRateLimit   = '10 sec'
    pollInterval      = '10 sec'
}

process.cache = 'lenient'
process.errorStrategy = {
    if (task.attempt == 1) return 'retry'
    if (task.previousException?.toString()?.contains('terminated for an unknown reason')) return 'retry'
    if (task.exitStatus in ((130..145) + 104)) return 'retry'
    return 'finish'
}

trace.fields = 'task_id,hash,native_id,process,tag,status,exit,submit,realtime,cpus,%cpu,peak_rss'

// B11 searched a whole sample's ORFs against one Pfam chunk in a single task: 65 minutes at the
// median and 144 at the worst, with only 2.25 of its 4 cores busy. Smaller read chunks give the
// queue more, shorter tasks, and hmmsearch doesn't scale past about 2 cores here anyway.
params.hmmsearch_chunksize = 256.MB

process {
    // depot.galaxyproject.org is unreachable from Codon's compute nodes, so pull nail's
    // biocontainer instead: nextflow.config sets singularity.registry = 'quay.io', which makes
    // this quay.io/biocontainers/nail:0.7.1--hab7d0fd_0. Drop this if depot becomes reachable.
    // Resources below are B11's measurements, not guesses; see docs/plans V5 results.
    withName: HMMER_HMMSEARCH {
        cpus = 2
        memory = { 4.GB * task.attempt }
        time = { 4.h * task.attempt }
    }

    // One task per sample now, not one per chunk, so it does in a single pass what twenty tasks
    // of about 1.5 minutes each did. Memory is the open question: 16.6 GB was the peak on a 20th
    // of Pfam, and the whole database's MMseqs2 target DB is the part that grows, hence the
    // headroom and the escalation on retry. No `disk`: nail's --tmp-dir is the task's work
    // directory on /hps/nobackup, so asking Slurm for node-local space only blocks submission.
    withName: NAIL_SEED {
        ext.singularity_pull_docker_container = true
        cpus = 8
        memory = { 48.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxRetries = 2
    }

    // Also one task per sample, holding every reported domain before it writes the Parquet.
    withName: HMMER_PAIRS {
        cpus = 8
        memory = { 32.GB * task.attempt }
        time = { 8.h * task.attempt }
        maxRetries = 2
    }
}
