/*
    The weefam arms: the pipeline's Pfam step on weefams.hmm (weefams_setup.sh) in place of Pfam, one whole file, as
    unchunked_pfam.config does for Pfam. Pass it instead of unchunked_pfam.config. run.sh exports WEEFAMS_DIR and
    WEEFAMS_MODELS, counted from the file so that -Z is the library's.

    kfpfam is its top mode as on reads (theta 9 seeds, bar 15, gate 14.5, gapped 21.25 or the model's own bar,
    band 15 at the first diagonal that passes; ORFs of real reads: the same pairs as band 16 at every diagonal,
    for less). The MGnify lookup is of Pfam, so it is off.
*/
params {
    databases.pfam = [
        chunked: false,
        remote_path: '',
        remote_checksum_path: false,
        remote_checksum: false,
        local_path: System.getenv('WEEFAMS_DIR') ?: '',
        files: [hmm: 'weefams.hmm'],
        variables: [num_models: (System.getenv('WEEFAMS_MODELS') ?: '0').toInteger()],
    ]
    kfpfam_prep = "${System.getenv('WEEFAMS_DIR')}/prep"
    kfpfam_index = "${System.getenv('WEEFAMS_DIR')}/index/top.tidx"
    kfpfam_bar = 15
    kfpfam_gate = 14.5
    kfpfam_min_gapped = 21.25
    pfam_lookup = false
}

process {
    // gapped.txt is in the prep directory, which the task stages as `prep`
    withName: 'PIPELINE:PROFILE_HMMSEARCH_PFAM:SEEDED_HMMER:KFPFAM_HMMER' {
        ext.args = 'FILTER_GAPPED_FILE=prep/gapped.txt FILTER_BAND=15 FILTER_DIAGONALS=any'
        memory = { 32.GB * task.attempt }
    }
}
