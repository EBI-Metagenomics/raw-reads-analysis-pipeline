cleanup = false

params {
    skip_qc = false
    skip_decontam = false
    skip_functional = false
    force_download_dbs = false

    decontam_short_chunksize = 160000000
    decontam_long_chunksize = 3200000
    cmsearch_chunksize = 260.MB
    hmmsearch_chunksize = 800.MB
    hmmsearch_subsampling = 2000000

    databases {
        cache_path = "download_cache/databases"

        motus {
            remote_path = "${projectDir}/tests/fixtures/dbs/motus_mini.tar.gz"
            remote_checksum_path = false
            local_path = ''
            files {
                base_dir = 'motus_mini/db_mOTU'
            }
        }

        host_genome {
            remote_path = "${projectDir}/tests/fixtures/dbs/host_genome_mini.tar.gz"
            remote_checksum_path = false
            local_path = ''
            files {
                bwa_index_prefix = 'host_genome_mini/hg38/hg38_mini.fa'
            }
        }

        host_genome_minimap2 {
            remote_path = "${projectDir}/tests/fixtures/dbs/hg38_mini_minimap2.tar.gz"
            remote_checksum_path = false
            local_path = ''
            files {
                index = 'hg38_mini_minimap2/hg38_mini.mmi'
            }
        }

        phix {
            remote_path = "${projectDir}/tests/fixtures/dbs/phix.tar.gz"
            remote_checksum_path = false
            local_path = ''
            files {
                bwa_index_prefix = 'phix/phix/MN385565.fasta'
            }
        }

        rfam {
            remote_path = "${projectDir}/tests/fixtures/dbs/rfam_mini.tar.gz"
            remote_checksum_path = false
            local_path = ''
            files {
                models = 'rfam_mini/rfam_models/ribosomal_models'
                claninfo = 'rfam_mini/rfam_models/ribosomal_models/ribo.claninfo'
            }
        }

        silva_ssu {
            remote_path = "${projectDir}/tests/fixtures/dbs/silva_ssu_mini.tar.gz"
            remote_checksum_path = false
            local_path = ''
            files {
                fasta = "silva_ssu_mini/silva_ssu-20200130/SSU.mini.fasta"
                tax = "silva_ssu_mini/silva_ssu-20200130/slv_ssu_filtered2.mini.txt"
                otu = "silva_ssu_mini/silva_ssu-20200130/ssu2.mini.otu"
                mscluster = "silva_ssu_mini/silva_ssu-20200130/..."
                version = "silva_ssu_mini/silva_ssu-20200130/..."
            }
            variables {
                label = 'SSU'
            }
        }

        silva_lsu {
            remote_path = "${projectDir}/tests/fixtures/dbs/silva_lsu_mini.tar.gz"
            remote_checksum_path = false
            local_path = ''
            files {
                fasta = "silva_lsu_mini/silva_lsu-20200130/LSU.mini.fasta"
                tax = "silva_lsu_mini/silva_lsu-20200130/slv_lsu_filtered2.mini.txt"
                otu = "silva_lsu_mini/silva_lsu-20200130/lsu2.mini.otu"
                mscluster = "silva_lsu_mini/silva_lsu-20200130/..."
                version = "silva_lsu_mini/silva_lsu-20200130/..."
            }
            variables {
                label = 'LSU'
            }
        }

        pfam {
            remote_path = "${projectDir}/tests/fixtures/dbs/pfam_mini.tar.gz"
            remote_checksum_path = false
            local_path = ''
            files {
                hmm = "pfam_mini/Pfam-A.hmm"
            }
            variables {
                num_models = 21979
            }
        }
    }
}

process {
    resourceLimits = [cpu: 2, memory: 4.GB]
}